<script>
  document.getElementById("year").textContent = new Date().getFullYear();

  document.querySelectorAll(".edit-project-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      document.getElementById("editProjectId").value = this.dataset.id || "";
      document.getElementById("editProjectName").value = this.dataset.nome || "";
      document.getElementById("editProjectDeadline").value = this.dataset.prazo || "";
      document.getElementById("editProjectStart").value = this.dataset.inicio || "";
      document.getElementById("editProjectLocation").value = this.dataset.localizacao || "";
      document.getElementById("editProjectDescription").value = this.dataset.descricao || "";
      document.getElementById("editProjectState").value = this.dataset.estado || "planeado";
      document.getElementById("editProjectBudget").value = this.dataset.orcamento || "";

      document.getElementById("deleteProjectLink").href =
        "/eliminar_projeto?id=" + (this.dataset.id || "");
    });
  });

  const taskForm = document.getElementById("taskForm");
  const taskModalTitle = document.getElementById("taskModalTitle");
  const deleteTaskBtn = document.getElementById("deleteTaskBtn");

  document.querySelectorAll(".open-create-task-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      taskModalTitle.textContent = "Nova Tarefa";
      taskForm.action = "/criar_tarefa";

      document.getElementById("taskId").value = "";
      document.getElementById("taskProjectId").value = this.dataset.projetoId || "";
      document.getElementById("taskTitle").value = "";
      document.getElementById("taskDescription").value = "";
      document.getElementById("taskWorker").value = "";
      document.getElementById("taskState").value = "pendente";
      document.getElementById("taskPriority").value = "media";
      document.getElementById("taskDeadline").value = "";

      deleteTaskBtn.style.display = "none";
      deleteTaskBtn.href = "#";
    });
  });

  document.querySelectorAll(".edit-task-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      taskModalTitle.textContent = "Editar Tarefa";
      taskForm.action = "/editar_tarefa";

      document.getElementById("taskId").value = this.dataset.id || "";
      document.getElementById("taskProjectId").value = this.dataset.projetoId || "";
      document.getElementById("taskTitle").value = this.dataset.titulo || "";
      document.getElementById("taskDescription").value = this.dataset.descricao || "";
      document.getElementById("taskWorker").value = this.dataset.trabalhadorId || "";
      document.getElementById("taskState").value = this.dataset.estado || "pendente";
      document.getElementById("taskPriority").value = this.dataset.prioridade || "media";
      document.getElementById("taskDeadline").value = this.dataset.dataLimite || "";

      deleteTaskBtn.style.display = "inline-block";
      deleteTaskBtn.href = "/eliminar_tarefa?id=" + (this.dataset.id || "");
    });
  });

  document.querySelectorAll(".edit-project-resource-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      document.getElementById("editProjectResourceProjectId").value = this.dataset.projetoId || "";
      document.getElementById("editProjectResourceId").value = this.dataset.recursoId || "";
      document.getElementById("editProjectResourceProjectName").value = this.dataset.projetoNome || "";
      document.getElementById("editProjectResourceName").value = this.dataset.recursoNome || "";
      document.getElementById("editProjectResourceQty").value = this.dataset.quantidadeAfetada || "";
    });
  });

  const noteForm = document.getElementById("noteForm");
  const noteModalTitle = document.getElementById("noteModalTitle");
  const deleteNoteBtn = document.getElementById("deleteNoteBtn");

  document.querySelectorAll(".open-create-note-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      noteModalTitle.textContent = "Nova Nota";
      noteForm.action = "/adicionar_nota_projeto";

      document.getElementById("noteId").value = "";
      document.getElementById("noteProjectId").value = this.dataset.projetoId || "";
      document.getElementById("noteProjectName").value = this.dataset.projetoNome || "";
      document.getElementById("noteTitle").value = "";
      document.getElementById("noteContent").value = "";

      deleteNoteBtn.style.display = "none";
      deleteNoteBtn.href = "#";
    });
  });

  document.querySelectorAll(".edit-note-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      noteModalTitle.textContent = "Editar Nota";
      noteForm.action = "/editar_nota_projeto";

      document.getElementById("noteId").value = this.dataset.id || "";
      document.getElementById("noteProjectId").value = this.dataset.projetoId || "";
      document.getElementById("noteProjectName").value = this.dataset.projetoNome || "";
      document.getElementById("noteTitle").value = this.dataset.titulo || "";
      document.getElementById("noteContent").value = this.dataset.conteudo || "";

      deleteNoteBtn.style.display = "inline-block";
      deleteNoteBtn.href = "/eliminar_nota_projeto?id=" + (this.dataset.id || "");
    });
  });
</script>