<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.getElementById("year").textContent = new Date().getFullYear();

  const dashboardGraficos = <?= json_encode($this->view->dashboard['graficos'], JSON_UNESCAPED_UNICODE) ?>;
  const dashboardMedias = <?= json_encode($this->view->dashboard['medias'] ?? [], JSON_UNESCAPED_UNICODE) ?>;
  const dashboardComparacoes = <?= json_encode($this->view->dashboard['comparacoes'] ?? [], JSON_UNESCAPED_UNICODE) ?>;

  const rootStyles = getComputedStyle(document.documentElement);
  const textColor = (rootStyles.getPropertyValue('--text-main') || '#111827').trim();
  const mutedColor = (rootStyles.getPropertyValue('--text-muted') || '#6b7280').trim();
  const borderColor = (rootStyles.getPropertyValue('--border-color') || 'rgba(0,0,0,0.08)').trim();

  const palette = [
    'rgba(13, 110, 253, 0.85)',
    'rgba(25, 135, 84, 0.85)',
    'rgba(255, 193, 7, 0.85)',
    'rgba(220, 53, 69, 0.85)',
    'rgba(111, 66, 193, 0.85)',
    'rgba(13, 202, 240, 0.85)'
  ];

  const metricLabels = {
    projetos: 'Projetos',
    trabalhadores: 'Trabalhadores',
    equipas: 'Equipas',
    recursos: 'Recursos',
    tarefas: 'Tarefas',
    orcamento: 'Orçamento'
  };

  const periodLabels = {
    mes: 'mês',
    trimestre: 'trimestre',
    semestre: 'semestre'
  };

  const commonOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        labels: {
          color: textColor
        }
      }
    },
    scales: {
      x: {
        ticks: { color: mutedColor },
        grid: { color: borderColor }
      },
      y: {
        beginAtZero: true,
        ticks: { color: mutedColor },
        grid: { color: borderColor }
      }
    }
  };

  const doughnutOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        labels: {
          color: textColor
        }
      }
    }
  };

  const lineOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        labels: {
          color: textColor
        }
      }
    },
    scales: {
      x: {
        ticks: { color: mutedColor },
        grid: { color: borderColor }
      },
      y: {
        beginAtZero: true,
        ticks: { color: mutedColor },
        grid: { color: borderColor }
      }
    }
  };

  const charts = {};

  function getSavedType(key, fallback) {
    return localStorage.getItem(key) || fallback;
  }

  function saveType(key, value) {
    localStorage.setItem(key, value);
  }

  function buildChart(canvasId, type, config) {
    if (charts[canvasId]) {
      charts[canvasId].destroy();
    }

    charts[canvasId] = new Chart(document.getElementById(canvasId), {
      type: type,
      data: config.data,
      options: config.options
    });
  }

  function formatNumber(value, metric) {
    const number = Number(value || 0);

    if (metric === 'orcamento') {
      return number.toLocaleString('pt-PT', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }) + ' €';
    }

    return number.toLocaleString('pt-PT', {
      minimumFractionDigits: 1,
      maximumFractionDigits: 1
    });
  }

  function formatPercent(value) {
    const number = Number(value || 0);
    const absValue = Math.abs(number);

    return absValue.toLocaleString('pt-PT', {
      minimumFractionDigits: 1,
      maximumFractionDigits: 1
    }) + '%';
  }

  function getTrendClass(value) {
    const number = Number(value || 0);
    if (number > 0) return 'trend-positive';
    if (number < 0) return 'trend-negative';
    return 'trend-neutral';
  }

  function getTrendSymbol(value) {
    const number = Number(value || 0);
    if (number > 0) return '▲';
    if (number < 0) return '▼';
    return '•';
  }

  function getTrendText(value) {
    const number = Number(value || 0);
    if (number > 0) return 'Cresceu face ao período anterior';
    if (number < 0) return 'Desceu face ao período anterior';
    return 'Sem variação face ao período anterior';
  }

  function updateMediaCard() {
    const periodo = document.getElementById('mediaPeriodoSelect').value;
    const metrica = document.getElementById('mediaMetricaSelect').value;

    const value = dashboardMedias?.[periodo]?.[metrica] ?? 0;

    document.getElementById('mediaCardNumber').textContent = formatNumber(value, metrica);
    document.getElementById('mediaCardSubtext').textContent =
      `Média de ${metricLabels[metrica].toLowerCase()} por ${periodLabels[periodo]}`;
  }

  function updateCompareCard(numberId, subtextId, periodo, metrica) {
    const compare = dashboardComparacoes?.[periodo]?.[metrica] || {
      atual: 0,
      anterior: 0,
      variacao_percentual: 0
    };

    const numberEl = document.getElementById(numberId);
    const subtextEl = document.getElementById(subtextId);

    const symbol = getTrendSymbol(compare.variacao_percentual);
    const formattedPercent = formatPercent(compare.variacao_percentual);

    numberEl.textContent = `${symbol} ${formattedPercent}`;
    numberEl.classList.remove('trend-positive', 'trend-negative', 'trend-neutral');
    numberEl.classList.add(getTrendClass(compare.variacao_percentual));

    subtextEl.textContent =
      `${getTrendText(compare.variacao_percentual)} · ${metricLabels[metrica]}: ${compare.atual} vs ${compare.anterior}`;
  }

  function renderProjetosEstado(type) {
    buildChart('chartProjetosEstado', type, {
      data: {
        labels: dashboardGraficos.projetos_por_estado.labels,
        datasets: [{
          label: 'Projetos',
          data: dashboardGraficos.projetos_por_estado.values,
          backgroundColor: palette,
          borderRadius: type === 'bar' ? 8 : 0
        }]
      },
      options: type === 'doughnut' ? doughnutOptions : commonOptions
    });
  }

  function renderRecursosStock(type) {
    buildChart('chartRecursosStock', type, {
      data: {
        labels: dashboardGraficos.recursos_por_stock.labels,
        datasets: [{
          label: 'Recursos',
          data: dashboardGraficos.recursos_por_stock.values,
          backgroundColor: [
            'rgba(25, 135, 84, 0.85)',
            'rgba(255, 193, 7, 0.85)',
            'rgba(220, 53, 69, 0.85)'
          ],
          borderRadius: type === 'bar' ? 8 : 0
        }]
      },
      options: type === 'doughnut' ? doughnutOptions : commonOptions
    });
  }

  function renderTarefasEstado(type) {
    buildChart('chartTarefasEstado', type, {
      data: {
        labels: dashboardGraficos.tarefas_por_estado.labels,
        datasets: [{
          label: 'Tarefas',
          data: dashboardGraficos.tarefas_por_estado.values,
          backgroundColor: [
            'rgba(255, 193, 7, 0.85)',
            'rgba(13, 202, 240, 0.85)',
            'rgba(25, 135, 84, 0.85)'
          ],
          borderRadius: type === 'bar' ? 8 : 0
        }]
      },
      options: type === 'doughnut' ? doughnutOptions : commonOptions
    });
  }

  function renderTarefasPrioridade(type) {
    buildChart('chartTarefasPrioridade', type, {
      data: {
        labels: dashboardGraficos.tarefas_por_prioridade.labels,
        datasets: [{
          label: 'Tarefas',
          data: dashboardGraficos.tarefas_por_prioridade.values,
          backgroundColor: [
            'rgba(25, 135, 84, 0.85)',
            'rgba(255, 193, 7, 0.85)',
            'rgba(220, 53, 69, 0.85)'
          ],
          borderRadius: type === 'bar' ? 8 : 0
        }]
      },
      options: type === 'doughnut' ? doughnutOptions : commonOptions
    });
  }

  function renderTopProjetos(type) {
    buildChart('chartTopProjetos', type, {
      data: {
        labels: dashboardGraficos.top_projetos_orcamento.labels,
        datasets: [{
          label: 'Orçamento (€)',
          data: dashboardGraficos.top_projetos_orcamento.values,
          backgroundColor: 'rgba(13, 110, 253, 0.85)',
          borderColor: 'rgba(13, 110, 253, 1)',
          tension: 0.3,
          fill: false,
          borderRadius: type === 'bar' ? 8 : 0
        }]
      },
      options: type === 'line' ? lineOptions : commonOptions
    });
  }

  function renderTemporal(periodo, metrica, tipo) {
    const dados = dashboardGraficos.temporais[periodo] || { labels: [] };

    const labelsMap = {
      projetos: 'Projetos',
      trabalhadores: 'Trabalhadores',
      equipas: 'Equipas',
      recursos: 'Recursos',
      tarefas: 'Tarefas',
      orcamento: 'Orçamento (€)'
    };

    const valores = dados[metrica] || [];
    const labelDataset = labelsMap[metrica] || 'Valor';

    buildChart('chartTemporalProjetos', tipo, {
      data: {
        labels: dados.labels || [],
        datasets: [{
          label: labelDataset,
          data: valores,
          backgroundColor: 'rgba(13, 110, 253, 0.85)',
          borderColor: 'rgba(13, 110, 253, 1)',
          tension: 0.3,
          fill: false,
          borderRadius: tipo === 'bar' ? 8 : 0
        }]
      },
      options: tipo === 'line' ? lineOptions : commonOptions
    });
  }

  const chartConfigs = [
    {
      selectId: 'chartTypeProjetosEstado',
      storageKey: 'dashboard_chart_projetos_estado',
      defaultType: 'doughnut',
      render: renderProjetosEstado
    },
    {
      selectId: 'chartTypeRecursosStock',
      storageKey: 'dashboard_chart_recursos_stock',
      defaultType: 'doughnut',
      render: renderRecursosStock
    },
    {
      selectId: 'chartTypeTarefasEstado',
      storageKey: 'dashboard_chart_tarefas_estado',
      defaultType: 'bar',
      render: renderTarefasEstado
    },
    {
      selectId: 'chartTypeTarefasPrioridade',
      storageKey: 'dashboard_chart_tarefas_prioridade',
      defaultType: 'bar',
      render: renderTarefasPrioridade
    },
    {
      selectId: 'chartTypeTopProjetos',
      storageKey: 'dashboard_chart_top_projetos',
      defaultType: 'bar',
      render: renderTopProjetos
    }
  ];

  chartConfigs.forEach((item) => {
    const select = document.getElementById(item.selectId);
    const savedType = getSavedType(item.storageKey, item.defaultType);

    select.value = savedType;
    item.render(savedType);

    select.addEventListener('change', function () {
      saveType(item.storageKey, this.value);
      item.render(this.value);
    });
  });

  function getTemporalSettings() {
    return {
      periodo: localStorage.getItem('dashboard_chart_temporal_periodo') || 'mes',
      metrica: localStorage.getItem('dashboard_chart_temporal_metrica') || 'projetos',
      tipo: localStorage.getItem('dashboard_chart_temporal_tipo') || 'bar'
    };
  }

  function saveTemporalSettings(periodo, metrica, tipo) {
    localStorage.setItem('dashboard_chart_temporal_periodo', periodo);
    localStorage.setItem('dashboard_chart_temporal_metrica', metrica);
    localStorage.setItem('dashboard_chart_temporal_tipo', tipo);
  }

  function getSummarySettings() {
    return {
      mediaPeriodo: localStorage.getItem('dashboard_media_periodo') || 'mes',
      mediaMetrica: localStorage.getItem('dashboard_media_metrica') || 'projetos',
      compare1Periodo: localStorage.getItem('dashboard_compare1_periodo') || 'trimestre',
      compare1Metrica: localStorage.getItem('dashboard_compare1_metrica') || 'tarefas',
      compare2Periodo: localStorage.getItem('dashboard_compare2_periodo') || 'semestre',
      compare2Metrica: localStorage.getItem('dashboard_compare2_metrica') || 'orcamento'
    };
  }

  function saveSummarySetting(key, value) {
    localStorage.setItem(key, value);
  }

  const temporalPeriodoSelect = document.getElementById('chartPeriodoTemporal');
  const temporalMetricaSelect = document.getElementById('chartMetricaTemporal');
  const temporalTipoSelect = document.getElementById('chartTypeTemporal');

  if (temporalPeriodoSelect && temporalMetricaSelect && temporalTipoSelect) {
    const temporalSaved = getTemporalSettings();

    temporalPeriodoSelect.value = temporalSaved.periodo;
    temporalMetricaSelect.value = temporalSaved.metrica;
    temporalTipoSelect.value = temporalSaved.tipo;

    renderTemporal(
      temporalSaved.periodo,
      temporalSaved.metrica,
      temporalSaved.tipo
    );

    function atualizarTemporal() {
      const periodo = temporalPeriodoSelect.value;
      const metrica = temporalMetricaSelect.value;
      const tipo = temporalTipoSelect.value;

      saveTemporalSettings(periodo, metrica, tipo);
      renderTemporal(periodo, metrica, tipo);
    }

    temporalPeriodoSelect.addEventListener('change', atualizarTemporal);
    temporalMetricaSelect.addEventListener('change', atualizarTemporal);
    temporalTipoSelect.addEventListener('change', atualizarTemporal);
  }

  const mediaPeriodoSelect = document.getElementById('mediaPeriodoSelect');
  const mediaMetricaSelect = document.getElementById('mediaMetricaSelect');
  const compare1PeriodoSelect = document.getElementById('compare1PeriodoSelect');
  const compare1MetricaSelect = document.getElementById('compare1MetricaSelect');
  const compare2PeriodoSelect = document.getElementById('compare2PeriodoSelect');
  const compare2MetricaSelect = document.getElementById('compare2MetricaSelect');

  const summarySaved = getSummarySettings();

  mediaPeriodoSelect.value = summarySaved.mediaPeriodo;
  mediaMetricaSelect.value = summarySaved.mediaMetrica;
  compare1PeriodoSelect.value = summarySaved.compare1Periodo;
  compare1MetricaSelect.value = summarySaved.compare1Metrica;
  compare2PeriodoSelect.value = summarySaved.compare2Periodo;
  compare2MetricaSelect.value = summarySaved.compare2Metrica;

  function refreshSummaryCards() {
    updateMediaCard();

    updateCompareCard(
      'compare1Number',
      'compare1Subtext',
      compare1PeriodoSelect.value,
      compare1MetricaSelect.value
    );

    updateCompareCard(
      'compare2Number',
      'compare2Subtext',
      compare2PeriodoSelect.value,
      compare2MetricaSelect.value
    );
  }

  mediaPeriodoSelect.addEventListener('change', function () {
    saveSummarySetting('dashboard_media_periodo', this.value);
    refreshSummaryCards();
  });

  mediaMetricaSelect.addEventListener('change', function () {
    saveSummarySetting('dashboard_media_metrica', this.value);
    refreshSummaryCards();
  });

  compare1PeriodoSelect.addEventListener('change', function () {
    saveSummarySetting('dashboard_compare1_periodo', this.value);
    refreshSummaryCards();
  });

  compare1MetricaSelect.addEventListener('change', function () {
    saveSummarySetting('dashboard_compare1_metrica', this.value);
    refreshSummaryCards();
  });

  compare2PeriodoSelect.addEventListener('change', function () {
    saveSummarySetting('dashboard_compare2_periodo', this.value);
    refreshSummaryCards();
  });

  compare2MetricaSelect.addEventListener('change', function () {
    saveSummarySetting('dashboard_compare2_metrica', this.value);
    refreshSummaryCards();
  });

  refreshSummaryCards();
</script>