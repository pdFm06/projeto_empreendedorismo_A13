<!DOCTYPE html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Painel Geral</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="style.css" />
  </head>

  <body>
    <div class="container py-4">
      <div class="page-header">
        <h1>Painel Geral</h1>
        <p class="subtitle">Visão geral dos indicadores</p>
      </div>

      <div class="row g-4 align-items-stretch">
        <div class="col-12 col-md-6 col-lg">
          <div class="project-card">
            <div class="project-title">Projetos ativos</div>
            <div class="dashboard-number">#</div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg">
          <div class="project-card">
            <div class="project-title">Média de progresso</div>
            <div class="dashboard-number">#</div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg">
          <div class="project-card">
            <div class="project-title">Projetos em risco</div>
            <div class="dashboard-number">#</div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg">
          <div class="project-card">
            <div class="project-title">Incidentes recentes</div>
            <div class="dashboard-number">#</div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg">
          <div class="project-card">
            <div class="project-title">Orçamento usado</div>
            <div class="dashboard-number">#</div>
          </div>
        </div>
      </div>

      <footer class="mt-4">
        © <span id="year"></span> Projeto Empreendedorismo — ISCTE · Grupo A13
      </footer>
    </div>

    <script>
      document.getElementById("year").textContent = new Date().getFullYear();
    </script>
  </body>
</html>