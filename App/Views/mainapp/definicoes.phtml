<!DOCTYPE html>
<html lang="pt">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Definições</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="definicoes.css">
</head>
<body>

	<div class="container py-5">

		<h1 class="mb-5 text-center">Definições da Conta</h1>

		<!-- Conta -->
		<section class="settings-section mb-5" aria-labelledby="accountTitle">
			<h2 id="accountTitle" class="h4">Conta</h2>
			<p class="text-muted">Altere as informações da sua conta.</p>

			<form id="accountForm" class="mt-3" novalidate>
				<div class="mb-3">
					<label for="userName" class="form-label">Nome</label>
					<input id="userName" name="name" type="text" class="form-control" placeholder="Nome do utilizador">
				</div>

				<div class="mb-3">
					<label for="userEmail" class="form-label">Email</label>
					<input id="userEmail" name="email" type="email" class="form-control" placeholder="email@exemplo.com">
				</div>

				<button type="submit" class="btn btn-primary">Guardar alterações</button>
			</form>
		</section>

		<!-- Palavra-passe -->
		<section class="settings-section mb-5" aria-labelledby="passwordTitle">
			<h2 id="passwordTitle" class="h4">Alterar Palavra-passe</h2>
			<p class="text-muted">Atualize a sua palavra-passe para manter a conta segura.</p>

			<form id="passwordForm" class="mt-3" novalidate>
				<div class="mb-3">
					<label for="currentPassword" class="form-label">Palavra-passe atual</label>
					<input id="currentPassword" name="current_password" type="password" class="form-control" required>
				</div>

				<div class="mb-3">
					<label for="newPassword" class="form-label">Nova palavra-passe</label>
					<input id="newPassword" name="new_password" type="password" class="form-control" required>
				</div>

				<div class="mb-3">
					<label for="confirmPassword" class="form-label">Confirmar palavra-passe</label>
					<input id="confirmPassword" name="confirm_password" type="password" class="form-control" required>
				</div>

				<button type="submit" class="btn btn-primary">Alterar palavra-passe</button>
			</form>
		</section>

		<!-- MFA -->
		<section class="settings-section mb-5" aria-labelledby="mfaTitle">
			<h2 id="mfaTitle" class="h4">Autenticação Multifator (MFA)</h2>
			<p class="text-muted">Adicione uma camada extra de segurança.</p>

			<div class="form-check form-switch mb-3">
				<input class="form-check-input" type="checkbox" id="mfaSwitch" aria-describedby="mfaHelp">
				<label class="form-check-label" for="mfaSwitch">Ativar MFA</label>
			</div>

			<div id="mfaBox" class="mt-3 visually-hidden" aria-hidden="true"> <!-- Podes so ignorar isto e usar a outra parte que tinhamos de meter o codigo já-->
				<p id="mfaHelp">Use uma aplicação autenticadora (Google Authenticator, Authy, etc.)</p>
				<label for="mfaCode" class="form-label mt-3">Código de confirmação</label>
				<input id="mfaCode" type="text" class="form-control" placeholder="Código de confirmação">

				<button id="confirmMfa" type="button" class="btn btn-success mt-3">Confirmar MFA</button>
			</div>
		</section>

		<!-- Notificações -->
		<section class="settings-section mb-5" aria-labelledby="notifTitle">
			<h2 id="notifTitle" class="h4">Notificações</h2>

			<div class="form-check form-switch mt-3">
				<input class="form-check-input" type="checkbox" id="notifEmail" checked>
				<label class="form-check-label" for="notifEmail">Receber notificações por email</label>
			</div>

			<div class="form-check form-switch mt-2">
				<input class="form-check-input" type="checkbox" id="notifNews">
				<label class="form-check-label" for="notifNews">Receber novidades da plataforma</label>
			</div>
		</section>

		<!-- Aparência -->
		<section class="settings-section mb-5" aria-labelledby="appearanceTitle">
			<h2 id="appearanceTitle" class="h4">Aparência</h2>

			<div class="form-check form-switch mt-3">
				<input class="form-check-input" type="checkbox" id="darkModeToggle">
				<label class="form-check-label" for="darkModeToggle">Modo escuro</label>
			</div>
		</section>

		<!-- Delete ACC -->
		<section class="settings-section danger-zone mb-5" aria-labelledby="dangerTitle">
			<button id="deleteAccount" type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">Eliminar conta</button>
		</section>

	</div>

	<!-- Modal: confirmação de eliminação com código -->
	<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
	  <div class="modal-dialog modal-dialog-centered">
	    <div class="modal-content">
	      <div class="modal-header">
	        <h5 class="modal-title" id="deleteAccountModalLabel">Confirmar eliminação da conta</h5>
	        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
	      </div>
	      <div class="modal-body">
	        <p>Esta ação é irreversível. Para confirmar, insira o código que foi enviado para o seu email.</p>
	        <div id="deleteCodeNote" class="alert alert-info d-none">Código enviado para o seu email.</div>
	        <div class="mb-3">
	          <label for="deleteCodeInput" class="form-label">Código de confirmação</label>
	          <input id="deleteCodeInput" type="text" class="form-control" placeholder="000000" aria-describedby="deleteCodeHelp">
	          <div id="deleteCodeHelp" class="form-text">Insira o código de 6 dígitos.</div>
	        </div>
	      </div>
	      <div class="modal-footer">
	        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
	        <button id="confirmDeleteBtn" type="button" class="btn btn-danger" disabled>Eliminar conta</button>
	      </div>
	    </div>
	  </div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			// Dark mode toggle: preserve preference
			const darkToggle = document.getElementById('darkModeToggle');
			if (darkToggle) {
				const saved = localStorage.getItem('prefers-dark');
				if (saved === '1') document.body.classList.add('dark-mode');
				darkToggle.checked = saved === '1';
				darkToggle.addEventListener('change', () => {
					const enabled = darkToggle.checked;
					document.body.classList.toggle('dark-mode', enabled);
					localStorage.setItem('prefers-dark', enabled ? '1' : '0');
				});
			}

			// MFA box visibility
			const mfaSwitch = document.getElementById('mfaSwitch');
			const mfaBox = document.getElementById('mfaBox');
			if (mfaSwitch && mfaBox) {
				mfaSwitch.addEventListener('change', () => {
					const enabled = mfaSwitch.checked;
					mfaBox.classList.toggle('visually-hidden', !enabled);
					mfaBox.setAttribute('aria-hidden', !enabled);
				});
			}

			// Delete account: gerar/validar código e confirmar
			const deleteModalEl = document.getElementById('deleteAccountModal');
			const deleteCodeInput = document.getElementById('deleteCodeInput');
			const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
			const deleteCodeNote = document.getElementById('deleteCodeNote');
			let expectedDeleteCode = null;

		});
	</script>

</body>
</html>