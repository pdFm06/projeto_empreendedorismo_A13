<script>
  document.getElementById("year").textContent = new Date().getFullYear();

  const resourceForm = document.getElementById("resourceForm");
  const addResourceTitle = document.getElementById("addResourceTitle");
  const deleteResourceBtn = document.getElementById("deleteResourceBtn");
  const openCreateResourceBtn = document.getElementById("openCreateResourceBtn");
  const resourceSearch = document.getElementById("resourceSearch");
  const clearSearch = document.getElementById("clearSearch");

  openCreateResourceBtn.addEventListener("click", function () {
    addResourceTitle.textContent = "Novo Recurso";
    resourceForm.action = "/criar_recurso";

    document.getElementById("resourceId").value = "";
    document.getElementById("resourceName").value = "";
    document.getElementById("resourceType").value = "material";
    document.getElementById("resourceQty").value = 0;
    document.getElementById("resourceCost").value = 0;
    document.getElementById("resourceState").value = "disponivel";

    deleteResourceBtn.style.display = "none";
    deleteResourceBtn.href = "#";
  });

  document.querySelectorAll(".edit-resource-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      addResourceTitle.textContent = "Editar Recurso";
      resourceForm.action = "/editar_recurso";

      document.getElementById("resourceId").value = this.dataset.id || "";
      document.getElementById("resourceName").value = this.dataset.nome || "";
      document.getElementById("resourceType").value = this.dataset.tipo || "material";
      document.getElementById("resourceQty").value = this.dataset.quantidade || 0;
      document.getElementById("resourceCost").value = this.dataset.custo || 0;
      document.getElementById("resourceState").value = this.dataset.estado || "disponivel";

      deleteResourceBtn.style.display = "inline-block";
      deleteResourceBtn.href = "/eliminar_recurso?id=" + (this.dataset.id || "");
    });
  });

  resourceSearch.addEventListener("input", function () {
    const termo = this.value.trim().toLowerCase();

    document.querySelectorAll(".resource-item").forEach((item) => {
      const texto = item.dataset.search || "";
      item.style.display = texto.includes(termo) ? "" : "none";
    });
  });

  clearSearch.addEventListener("click", function () {
    resourceSearch.value = "";
    document.querySelectorAll(".resource-item").forEach((item) => {
      item.style.display = "";
    });
  });
</script>