<?php
$acaoConfig = $this->view->mfa_config_action ?? null;

$titulo = 'Verificação MFA';
$texto = 'Introduza o código de 6 dígitos enviado para o seu email.';
$formAction = '/validar_mfa';
$textoBotao = 'Validar código';
$linkVoltar = '/login';
$textoVoltar = 'Voltar ao login';

if ($acaoConfig === 'ativar') {
    $titulo = 'Confirmar ativação da MFA';
    $texto = 'Introduza o código de 6 dígitos enviado para o seu email para concluir a ativação da MFA.';
    $formAction = '/confirmar_mfa_config';
    $textoBotao = 'Confirmar ativação';
    $linkVoltar = '/definicoes';
    $textoVoltar = 'Voltar às definições';
} elseif ($acaoConfig === 'desativar') {
    $titulo = 'Confirmar desativação da MFA';
    $texto = 'Introduza o código de 6 dígitos enviado para o seu email para concluir a desativação da MFA.';
    $formAction = '/confirmar_mfa_config';
    $textoBotao = 'Confirmar desativação';
    $linkVoltar = '/definicoes';
    $textoVoltar = 'Voltar às definições';
}
?>

<form action="<?= htmlspecialchars($formAction) ?>" method="post">
  <h2 class="text-center mb-2"><?= htmlspecialchars($titulo) ?></h2>
  <p class="text-center text-muted mb-4">
    <?= htmlspecialchars($texto) ?>
  </p>

  <div class="form-floating mb-3">
    <input
      type="text"
      class="form-control"
      id="mfaCode"
      placeholder="Código MFA"
      name="codigo"
      maxlength="6"
      inputmode="numeric"
      pattern="[0-9]{6}"
      required
    />
    <label for="mfaCode">Código de verificação</label>
  </div>

  <button type="submit" class="btn btn-primary w-100">
    <?= htmlspecialchars($textoBotao) ?>
  </button>

  <div class="text-center mt-3 small">
    <a href="<?= htmlspecialchars($linkVoltar) ?>"><?= htmlspecialchars($textoVoltar) ?></a>
  </div>
</form>