<script>
  document.getElementById("year").textContent = new Date().getFullYear();

  const teamForm = document.getElementById("teamForm");
  const teamModalTitle = document.getElementById("teamModalTitle");
  const deleteTeamBtn = document.getElementById("deleteTeamBtn");
  const openCreateTeamBtn = document.getElementById("openCreateTeamBtn");

  openCreateTeamBtn.addEventListener("click", function () {
    teamModalTitle.textContent = "Nova Equipa";
    teamForm.action = "/criar_equipa";

    document.getElementById("teamId").value = "";
    document.getElementById("teamName").value = "";
    document.getElementById("teamSpecialty").value = "";
    document.getElementById("teamLeader").value = "";

    deleteTeamBtn.style.display = "none";
    deleteTeamBtn.href = "#";
  });

  document.querySelectorAll(".edit-team-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      teamModalTitle.textContent = "Editar Equipa";
      teamForm.action = "/editar_equipa";

      document.getElementById("teamId").value = this.dataset.id || "";
      document.getElementById("teamName").value = this.dataset.nome || "";
      document.getElementById("teamSpecialty").value = this.dataset.especialidade || "";
      document.getElementById("teamLeader").value = this.dataset.liderId || "";

      deleteTeamBtn.style.display = "inline-block";
      deleteTeamBtn.href = "/eliminar_equipa?id=" + (this.dataset.id || "");
    });
  });
</script>