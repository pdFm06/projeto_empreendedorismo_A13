<script>
  document.getElementById("year").textContent = new Date().getFullYear();

  const form = document.getElementById("personForm");
  const modalTitle = document.getElementById("createPersonTitle");
  const deleteBtn = document.getElementById("deletePersonBtn");
  const openCreateBtn = document.getElementById("openCreateWorkerBtn");

  openCreateBtn.addEventListener("click", function () {
    modalTitle.textContent = "Novo Trabalhador";
    form.action = "/criar_trabalhador";

    document.getElementById("personId").value = "";
    document.getElementById("personName").value = "";
    document.getElementById("personEmail").value = "";
    document.getElementById("personPhone").value = "";
    document.getElementById("personRole").value = "";
    document.getElementById("personSalary").value = "";
    document.getElementById("personStatus").value = "ativo";

    deleteBtn.style.display = "none";
    deleteBtn.href = "#";
  });

  document.querySelectorAll(".edit-worker-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      modalTitle.textContent = "Editar Trabalhador";
      form.action = "/editar_trabalhador";

      document.getElementById("personId").value = this.dataset.id || "";
      document.getElementById("personName").value = this.dataset.nome || "";
      document.getElementById("personEmail").value = this.dataset.email || "";
      document.getElementById("personPhone").value = this.dataset.telefone || "";
      document.getElementById("personRole").value = this.dataset.funcao || "";
      document.getElementById("personSalary").value = this.dataset.salario || "";
      document.getElementById("personStatus").value = this.dataset.estado || "ativo";

      deleteBtn.style.display = "inline-block";
      deleteBtn.href = "/eliminar_trabalhador?id=" + (this.dataset.id || "");
    });
  });

  const injuryForm = document.getElementById("injuryForm");
  const injuryModalTitle = document.getElementById("injuryModalTitle");
  const deleteInjuryBtn = document.getElementById("deleteInjuryBtn");

  document.querySelectorAll(".open-injury-create-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      injuryModalTitle.textContent = "Nova Lesão";
      injuryForm.action = "/adicionar_lesao_trabalhador";

      document.getElementById("injuryId").value = "";
      document.getElementById("injuryWorkerId").value = this.dataset.trabalhadorId || "";
      document.getElementById("injuryWorkerName").value = this.dataset.trabalhadorNome || "";
      document.getElementById("injuryTitle").value = "";
      document.getElementById("injuryDescription").value = "";
      document.getElementById("injuryDate").value = "";
      document.getElementById("injuryReturnExpected").value = "";
      document.getElementById("injuryReturnReal").value = "";
      document.getElementById("injuryStatus").value = "ativa";
      document.getElementById("injuryNotes").value = "";

      deleteInjuryBtn.style.display = "none";
      deleteInjuryBtn.href = "#";
    });
  });

  document.querySelectorAll(".edit-injury-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      injuryModalTitle.textContent = "Editar Lesão";
      injuryForm.action = "/editar_lesao_trabalhador";

      document.getElementById("injuryId").value = this.dataset.id || "";
      document.getElementById("injuryWorkerId").value = this.dataset.trabalhadorId || "";
      document.getElementById("injuryWorkerName").value = this.dataset.trabalhadorNome || "";
      document.getElementById("injuryTitle").value = this.dataset.titulo || "";
      document.getElementById("injuryDescription").value = this.dataset.descricao || "";
      document.getElementById("injuryDate").value = this.dataset.dataLesao || "";
      document.getElementById("injuryReturnExpected").value = this.dataset.dataRegressoPrevista || "";
      document.getElementById("injuryReturnReal").value = this.dataset.dataRegressoReal || "";
      document.getElementById("injuryStatus").value = this.dataset.estado || "ativa";
      document.getElementById("injuryNotes").value = this.dataset.observacoes || "";

      deleteInjuryBtn.style.display = "inline-block";
      deleteInjuryBtn.href = "/eliminar_lesao_trabalhador?id=" + (this.dataset.id || "");
    });
  });
</script>