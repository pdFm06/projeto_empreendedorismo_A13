<!-- Modal: Criar / Editar Trabalhador -->
<div
  class="modal fade"
  id="createPersonModal"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="createPersonTitle">Novo Trabalhador</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Fechar"
        ></button>
      </div>

      <div class="modal-body">
        <form id="personForm" method="post" action="/criar_trabalhador">
          <input type="hidden" id="personId" name="id" />

          <div class="mb-3">
            <label class="form-label" for="personName">Nome</label>
            <input id="personName" name="nome" class="form-control" required />
          </div>

          <div class="mb-3">
            <label class="form-label" for="personEmail">Email</label>
            <input id="personEmail" name="email" type="email" class="form-control" />
          </div>

          <div class="mb-3">
            <label class="form-label" for="personPhone">Telefone</label>
            <input id="personPhone" name="telefone" class="form-control" />
          </div>

          <div class="mb-3">
            <label class="form-label" for="personRole">Função</label>
            <input id="personRole" name="funcao" class="form-control" />
          </div>

          <div class="mb-3">
            <label class="form-label" for="personSalary">Salário por dia</label>
            <input
              id="personSalary"
              name="salario_dia"
              type="number"
              step="0.01"
              min="0"
              class="form-control"
            />
          </div>

          <div class="mb-3">
            <label class="form-label" for="personStatus">Estado</label>
            <select id="personStatus" name="estado" class="form-control">
              <option value="ativo">Ativo</option>
              <option value="inativo">Inativo</option>
            </select>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button
          class="btn btn-secondary"
          data-bs-dismiss="modal"
          type="button"
        >
          Cancelar
        </button>

        <a
          href="#"
          class="btn btn-danger"
          id="deletePersonBtn"
          style="display: none"
          onclick="return confirm('Eliminar trabalhador permanentemente?')"
        >
          Eliminar
        </a>

        <button
          class="btn btn-primary"
          id="savePersonBtn"
          type="submit"
          form="personForm"
        >
          Guardar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById("year").textContent = new Date().getFullYear();

  const form = document.getElementById("personForm");
  const modalTitle = document.getElementById("createPersonTitle");
  const deleteBtn = document.getElementById("deletePersonBtn");
  const openCreateBtn = document.getElementById("openCreateWorkerBtn");

  openCreateBtn.addEventListener("click", function () {
    modalTitle.textContent = "Novo Trabalhador";
    form.action = "/criar_trabalhador";

    document.getElementById("personId").value = "";
    document.getElementById("personName").value = "";
    document.getElementById("personEmail").value = "";
    document.getElementById("personPhone").value = "";
    document.getElementById("personRole").value = "";
    document.getElementById("personSalary").value = "";
    document.getElementById("personStatus").value = "ativo";

    deleteBtn.style.display = "none";
    deleteBtn.href = "#";
  });

  document.querySelectorAll(".edit-worker-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      modalTitle.textContent = "Editar Trabalhador";
      form.action = "/editar_trabalhador";

      document.getElementById("personId").value = this.dataset.id || "";
      document.getElementById("personName").value = this.dataset.nome || "";
      document.getElementById("personEmail").value = this.dataset.email || "";
      document.getElementById("personPhone").value = this.dataset.telefone || "";
      document.getElementById("personRole").value = this.dataset.funcao || "";
      document.getElementById("personSalary").value = this.dataset.salario || "";
      document.getElementById("personStatus").value = this.dataset.estado || "ativo";

      deleteBtn.style.display = "inline-block";
      deleteBtn.href = "/eliminar_trabalhador?id=" + (this.dataset.id || "");
    });
  });
</script>