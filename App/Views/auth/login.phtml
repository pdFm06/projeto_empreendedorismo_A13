<form action="/autenticar" method="post">
  <h2 class="text-center mb-2">Iniciar sessão</h2>
  <p class="text-center text-muted mb-4">
    Entre com as suas credenciais para aceder à plataforma.
  </p>

  <div class="form-floating mb-3">
    <input
      type="email"
      class="form-control"
      id="loginEmail"
      placeholder="nome@exemplo.com"
      name="email"
      required
    />
    <label for="loginEmail">E-mail</label>
  </div>

  <div class="form-floating mb-3">
    <input
      type="password"
      class="form-control"
      id="loginPassword"
      placeholder="Palavra-passe"
      name="password"
      required
    />
    <label for="loginPassword">Palavra-passe</label>
  </div>

  <div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="remember" />
    <label class="form-check-label small" for="remember">
      Lembrar-me
    </label>
  </div>

  <button type="submit" class="btn btn-primary w-100">
    Entrar
  </button>

  <div class="text-center mt-3 small">
    Ainda não tem conta?
    <a href="/registar">Criar conta</a>
  </div>

  <div class="text-center mt-2 small">
    Esqueceu-se da palavra-passe?
    <a href="/trocar_palavra_passe">Recuperar acesso</a>
  </div>
</form>