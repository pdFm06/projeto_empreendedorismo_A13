<form action="/criar_conta" method="post">
  <h2 class="text-center mb-2">Criar conta</h2>
  <p class="text-center text-muted mb-4">
    Registe-se para começar a utilizar a plataforma.
  </p>

  <div class="form-floating mb-3">
    <input
      type="email"
      class="form-control"
      id="registerEmail"
      placeholder="nome@exemplo.com"
      name="email"
      required
    />
    <label for="registerEmail">E-mail</label>
  </div>

  <div class="form-floating mb-3">
    <input
      type="password"
      class="form-control"
      id="registerPassword"
      placeholder="Palavra-passe"
      name="password"
      required
    />
    <label for="registerPassword">Palavra-passe</label>
  </div>

  <div class="form-floating mb-3">
    <input
      type="password"
      class="form-control"
      id="registerPassword2"
      placeholder="Confirmar palavra-passe"
      name="password2"
      required
    />
    <label for="registerPassword2">Confirmar palavra-passe</label>
  </div>

  <button type="submit" class="btn btn-primary w-100">
    Registar
  </button>

  <div class="text-center mt-3 small">
    Já tem conta?
    <a href="/login">Iniciar sessão</a>
  </div>
</form>